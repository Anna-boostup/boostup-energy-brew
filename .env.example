# ------------------------------------------------------------------------------
# ZÁKLADNÍ PROMĚNNÉ PRO FRONTEND (VITE) A SUPABASE
# ------------------------------------------------------------------------------
# Tyto proměnné jsou veřejně dostupné prohlížeči (prefix VITE_)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1...

# Adresa vaší stránky (pro absolutní odkazy v e-mailech atd.)
VITE_SITE_URL=https://www.drinkboostup.cz

# ------------------------------------------------------------------------------
# BEZPEČNOSTNÍ PROMĚNNÉ SERVERU (API) - NIKDY NEDÁVAT DO VITE_
# ------------------------------------------------------------------------------
# Klíč s plnými právy k databázi (obchází Row Level Security). Pouze pro Serverless (Vercel) API!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1...

# ------------------------------------------------------------------------------
# ANALYTIKA A MONITORING
# ------------------------------------------------------------------------------
# Měřicí ID pro Google Analytics 4 (GA4) - používá se v index.html
VITE_GA_ID=G-XXXXXXXXXX

# Sentry DSN klíč pro logování chyb v prohlížeči
VITE_SENTRY_DSN=https://xxxxxxxxxxx@xxxxxxx.ingest.sentry.io/xxxxxxx

# Sentry administrační klíč pro nahrávání Source Maps při buildu na Vercelu
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# PLATEBNÍ BRÁNY A SLUŽBY
# ------------------------------------------------------------------------------
# GoPay integrace
GOPAY_GO_ID=1234567890
GOPAY_CLIENT_ID=xxxxxxxxxx
GOPAY_CLIENT_SECRET=xxxxxxxxxx
# Pro testování nastavte na https://gw.sandbox.gopay.com/api
GOPAY_API_URL=https://gate.gopay.cz/api

# Stripe integrace
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# DOPRAVA (ZÁSILKOVNA / PACKETA)
# ------------------------------------------------------------------------------
VITE_PACKETA_API_KEY=xxxxxxxxxxxxxxxx
PACKETA_API_PASSWORD=xxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# E-MAILING (RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# EXPORT DO ÚČETNICTVÍ (MONEY S3)
# ------------------------------------------------------------------------------
# Tajný token, kterým MoneyS3 autorizuje své požadavky proti vašemu API
MONEY_S3_TOKEN=tajny_token_pro_ucetnictvi

# ------------------------------------------------------------------------------
# SLACK NOTIFIKACE (WEBHOOKS)
# ------------------------------------------------------------------------------
# Upozornění na objednávky
SLACK_ORDERS_WEBHOOK_URL=https://hooks.slack.com/services/T0000/B0000/XXXX
# Systémová upozornění (nasazení nové verze atd.)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T0000/B0000/XXXX

# ------------------------------------------------------------------------------
# CRON ÚLOHY
# ------------------------------------------------------------------------------
# Tajný token pro spouštění automatických Vercel Cron Jobs (např. měsíční report)
CRON_SECRET=super_tajny_cron_token
# Výchozí e-mail pro zasílání reportů (pokud není nastaven v DB)
REPORT_EMAIL=objednavky@drinkboostup.cz

# ------------------------------------------------------------------------------
# VÝVOJOVÉ PROMĚNNÉ
# ------------------------------------------------------------------------------
# "true" nebo "false". Pokud true, platby nepůjdou ostře na platební brány.
IS_TEST_MODE=false
